{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dota 2 Counter Overlay",
  "version": "0.1.0",
  "identifier": "com.dota2overlay.app",
  "build": {
    "frontendDist": "../wwwroot",
    "beforeDevCommand": "node scripts/syncFrontendEngine.js",
    "beforeBuildCommand": "node scripts/syncFrontendEngine.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dota 2 Counter Overlay",
        "width": 380,
        "height": 650,
        "minWidth": 380,
        "minHeight": 110,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$RESOURCE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
